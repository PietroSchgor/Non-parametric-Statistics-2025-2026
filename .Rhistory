# 2. Ricalcoliamo la parabola di soglia ESATTAMENTE sulla griglia mei_seq
# Usiamo la formula teorica della parabola e sottraiamo l'offset
mbd_soglia <- (a0 + a1 * mei_seq + a2 * mei_seq^2) - F_offset
